{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr update-branch:*)",
      "Bash(gh pr comment:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 20,
            "onFailure": "continue"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/node-path.sh",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "$ARGUMENTS - If stop_hook_active is true, return {\"ok\": true}. Return {\"ok\": false, \"reason\": \"End this turn with the question card: ask the choice with AskUserQuestion, the recommended option first.\"} only if last_assistant_message ends by asking the operator to pick between two to four options, which variant to take, or whether a push or other step may go ahead, written as prose. Return {\"ok\": true} for everything else: a report, a summary, a list of findings, a handover (a /goal line, a command block for the operator to run, a Waiting note), a progress report in a running task, or a question already asked with the card.",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit-gate.sh",
            "timeout": 300,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "plansDirectory": "repos/khe-meta/plans"
}
