# The KHE repos are independent checkouts cloned by scripts/workspace.sh.
# `repos/*` rather than `repos/` so the manifest and README stay tracked.
/repos/*
!/repos/repos.yaml

# Local-only overrides (per-machine, not committed)
*.local.md
*.local.toml
*.local.json
.claude/launch.json
.codex/config.toml

# Desktop worktrees of the workspace root; .worktrees/ holds worktrees of the root and of repos/<name>
.claude/worktrees/
/.worktrees/

# Tool output (00000.log is OrcaSlicer's CLI log, written to the cwd)
.playwright-mcp/
00000.log

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
