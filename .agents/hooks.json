{
  "session-start": {
    "SessionStart": [
      {
        "type": "command",
        "command": "./hooks/session-start-adapter.sh",
        "timeout": 20
      }
    ]
  },
  "commit-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/commit-gate-adapter.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
